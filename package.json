{
  "name": "avg-menggongchang",
  "version": "1.0.0",
  "description": "AVG梦工厂 — AI 视觉小说创作与游玩平台",
  "main": "electron/main.js",
  "author": "AVG梦工厂 Contributors",
  "license": "MIT",
  "homepage": "https://github.com/nanihaikeyidai/meilin-dream-game",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanihaikeyidai/meilin-dream-game.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "smoke": "bash frontend/smoke_test.sh",
    "test:preflight": "node scripts/avg-preflight.mjs",
    "test:preflight:layout": "node scripts/avg-preflight.mjs --allow-llm-fail",
    "test": "node scripts/avg-preflight.mjs --allow-llm-fail",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:all": "electron-builder --win --mac --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.avg.menggongchang",
    "productName": "AVG-MengGongChang",
    "executableName": "AVG-MengGongChang",
    "copyright": "Copyright © 2026 AVG梦工厂 Contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "templates/**/*",
      "server.js",
      ".env.example",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "AVG-MengGongChang-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "AVG-MengGongChang-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "AVG-MengGongChang ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AVG-MengGongChang"
    },
    "portable": {
      "artifactName": "AVG-MengGongChang-${version}-win-portable.${ext}"
    }
  }
}
