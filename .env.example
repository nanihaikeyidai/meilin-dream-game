# 复制为 .env 后填写（npm run dev 会自动加载）
# DeepSeek 示例（与 Hermes custom endpoint 一致）:
LLM_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 本地 Hermes Gateway（无需 API Key）:
# LLM_BASE=http://localhost:8656
# LLM_MODEL=july

# 无 LLM 时仅测布局/UI（返回 Mock 叙事）:
# AVG_MOCK_LLM=1

# TTS（可选）
# TTS_BASE=http://localhost:7860
